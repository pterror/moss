# Nix build output symlink
/result

# Documentation build
site/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Normalize runtime data (see bottom for exceptions)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
*.egg-info/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# build output
dist/
target/
# generated types
.astro/

# dependencies
node_modules/
bun.lockb

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Desloppify
.desloppify/
scorecard.png

# jetbrains setting folder
.idea/

# direnv
.direnv/

# database
*.sqlite
*.sqlite-shm
*.sqlite-wal

# typescript build info
*.tsbuildinfo

# vitepress cache
cache/

# debugging text files
*.txt
# ...except fixture inputs/outputs — these are committed test data, not
# scratch debugging output. The narrower "expected/*.txt"-only exception
# previously let a real fixture (tests/fixtures/cmake/CMakeLists.txt) get
# silently dropped by `git add`, breaking the whole query_fixtures test
# binary's compilation with no warning at commit time.
!**/tests/fixtures/**/*.txt
# ...except embedded help text included via include_str!
!**/src/**/help.txt
# ...except CMake's canonical fixture filename (CMakeLists.txt is not
# optional — it's the only filename CMake recognizes), which the blanket
# *.txt rule above silently swallowed
!**/tests/fixtures/cmake/CMakeLists.txt

*.cpuprofile

# Normalize - ignore .normalize/ in subdirectories (but not root)
*/**/.normalize/

# Root .normalize/ - ignore all but config files
/.normalize/*
!/.normalize/config.toml
!/.normalize/SUMMARY.md
!/.normalize/rule-tests/
!/.normalize/kg/

# Normalize
.normalize/*
!.normalize/config.toml
!.normalize/SUMMARY.md
!.normalize/rule-tests/
!.normalize/memory/
!.normalize/kg/
.normalize/shadow
.fastembed_cache/
