// Real-world-shaped KDL: a package-manifest-style document, the dominant
// real-world use case for KDL (Cargo alternative manifests, zellij configs,
// etc).

package {
  name "my-app"
  version "1.2.3"
  description "An example application"
  license "MIT"
}

dependencies {
  serde version="1.0" features="derive"
  tokio version="1.0"
  "kdl-rs" version="6.0"
}

dev-dependencies {
  criterion version="0.5"
}

// A typed leaf value: (u16) annotates the value's type.
config {
  port (u16)8080
  debug false
  max_connections 100
}

// A node with neither children nor arguments is still a bare leaf entry.
empty-node
