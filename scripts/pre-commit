#!/usr/bin/env bash
# Pre-commit hook: format check, clippy, and normalize checks — scoped to
# what's actually staged, not the whole workspace.
#
# Auto-installed via `nix develop` shellHook. To install manually:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Why scoped: this repo runs many agents concurrently in the same working
# tree. A commit's validity must not depend on unrelated uncommitted files
# elsewhere in the workspace (a different agent's in-progress edits can
# leave other crates non-compiling). Scoping to the crates touched by the
# staged changes also cuts wall-clock from minutes (full-workspace clippy)
# to seconds for a typical single-crate commit.
#
# Guarantee traded away: this hook does NOT prove the whole workspace
# builds/lints clean, only that the touched package(s) do. It does not catch
# breakage in crates that depend on a touched crate (e.g. a signature change
# that breaks a downstream consumer). CI (.github/workflows/ci.yml) already
# runs `cargo fmt --all --check`, `cargo clippy --workspace --all-features`,
# and `cargo test --workspace` on every push/PR — that's the full-workspace
# safety net. Cargo.toml/Cargo.lock/toolchain changes fall back to a
# full-workspace check below since those affect every crate.
#
# fmt is checked against staged *blob content*, not the working tree: a
# package-scoped `cargo fmt -p <pkg> --check` still walks every file in that
# package's working tree, so an unrelated file mid-edit elsewhere in the
# same package fails the check for everyone (this blocked real commits —
# see the commit that added this comment). rustfmt is per-file and doesn't
# need a compiling tree, so staged .rs files are materialized into a scratch
# dir (same pattern as the .calls.scm validation below) and checked directly
# with `rustfmt --check`, never touching the working tree.
#
# clippy does NOT get the same treatment: it needs a coherent, compiling
# tree to mean anything, and staged-only content may reference unstaged
# symbols. It stays scoped to `-p <pkg>` against the working tree, which
# means it inherits the same limitation cargo fmt used to have — an
# unrelated in-progress edit elsewhere in a touched package can still fail
# clippy for a commit that didn't touch it. No cheap fix for that without
# materializing (and compiling) a full staged tree.

set -euo pipefail

# Files staged for this commit (Added/Copied/Modified/Renamed; excludes
# Deleted since there's nothing left to check).
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#STAGED[@]}" -eq 0 ]; then
    echo "No staged files; nothing to check."
    exit 0
fi

# Shared scratch dir for materializing staged blob content (fmt check,
# .calls.scm validation). Never touches the working tree.
TMP_ROOT="$(mktemp -d)"
trap 'rm -rf "$TMP_ROOT"' EXIT

# --- Determine which cargo packages are touched -----------------------
workspace_wide=false
declare -A PKG_SET
declare -A PKG_DIR
for f in "${STAGED[@]}"; do
    case "$f" in
        Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*)
            workspace_wide=true
            ;;
        crates/*/*)
            dir="crates/$(echo "$f" | cut -d/ -f2)"
            ;;
        xtask/*)
            dir="xtask"
            ;;
        benches/*)
            dir="benches"
            ;;
        *)
            dir=""
            ;;
    esac
    if [ -n "${dir:-}" ] && [ -f "$dir/Cargo.toml" ]; then
        pkg=$(sed -n 's/^name *= *"\(.*\)"/\1/p' "$dir/Cargo.toml" | head -1)
        if [ -n "$pkg" ]; then
            PKG_SET["$pkg"]=1
            PKG_DIR["$pkg"]="$dir"
        fi
    fi
    dir=""
done

PKGS=("${!PKG_SET[@]}")

# Resolve the Rust edition a package's files should be formatted against
# (needed since rustfmt is invoked directly, not via `cargo fmt`, which
# would normally read this from Cargo.toml itself).
edition_for_dir() {
    local dir="$1" e
    e=$(sed -n 's/^edition *= *"\(.*\)"/\1/p' "$dir/Cargo.toml" | head -1)
    if [ -n "$e" ]; then
        echo "$e"
        return
    fi
    # edition.workspace = true — fall back to the workspace default.
    sed -n 's/^edition *= *"\(.*\)"/\1/p' Cargo.toml | head -1
}

if [ "$workspace_wide" = true ]; then
    echo "Workspace manifest/lockfile/toolchain staged — running full-workspace checks..."
    echo "Running cargo fmt check..."
    cargo fmt --check
    echo "Running cargo clippy (workspace)..."
    cargo clippy --all-targets --all-features -- -D warnings
elif [ "${#PKGS[@]}" -gt 0 ]; then
    PKG_ARGS=()
    for p in "${PKGS[@]}"; do
        PKG_ARGS+=(-p "$p")
    done

    # fmt: check staged *content*, not the working tree (see header
    # comment). Materialize each staged .rs file that belongs to a touched
    # package into the scratch dir, then run rustfmt --check directly,
    # grouped by edition.
    fmt_tmp="$TMP_ROOT/fmt"
    declare -A EDITION_FILES
    fmt_file_count=0
    for f in "${STAGED[@]}"; do
        case "$f" in
            *.rs) ;;
            *) continue ;;
        esac
        for p in "${PKGS[@]}"; do
            d="${PKG_DIR[$p]}"
            case "$f" in
                "$d"/*)
                    mkdir -p "$fmt_tmp/$(dirname "$f")"
                    git show ":$f" >"$fmt_tmp/$f"
                    ed=$(edition_for_dir "$d")
                    EDITION_FILES["$ed"]+="$fmt_tmp/$f "
                    fmt_file_count=$((fmt_file_count + 1))
                    break
                    ;;
            esac
        done
    done

    # A materialized file's `mod X;` declarations need X.rs / X/mod.rs to
    # physically exist in the scratch dir too, or rustfmt fails with
    # "failed to resolve mod" before it ever gets to check formatting —
    # even when X itself has no staged changes (e.g. a test file's `mod
    # common;` pointing at an untouched `tests/common/mod.rs` shared
    # helper). Pull in any such sibling module files from the working
    # tree (not the index — they're only present to satisfy module
    # resolution, not to be format-checked themselves) and repeat until
    # nothing new is added, since a pulled-in file can itself declare
    # further `mod` children.
    # These pulled-in files are deliberately NOT added to EDITION_FILES —
    # rustfmt already recurses into every `mod`-reachable file starting
    # from each root passed on the command line, so an untouched, already-
    # formatted helper module gets checked as a side effect of resolving
    # the staged file that references it. Adding it a second time as its
    # own root would report false-positive violations for files this
    # commit never touched.
    if [ "$fmt_file_count" -gt 0 ]; then
        shopt -s globstar nullglob
        added=true
        while [ "$added" = true ]; do
            added=false
            for f in "$fmt_tmp"/**/*.rs; do
                [ -f "$f" ] || continue
                rel="${f#"$fmt_tmp"/}"
                dir="$(dirname "$rel")"
                while IFS= read -r modname; do
                    [ -n "$modname" ] || continue
                    for cand in "$dir/$modname.rs" "$dir/$modname/mod.rs"; do
                        if [ -f "$cand" ] && [ ! -f "$fmt_tmp/$cand" ]; then
                            mkdir -p "$fmt_tmp/$(dirname "$cand")"
                            cp "$cand" "$fmt_tmp/$cand"
                            added=true
                        fi
                    done
                done < <(sed -n 's/^[[:space:]]*mod[[:space:]]\+\([a-zA-Z_][a-zA-Z0-9_]*\)[[:space:]]*;.*/\1/p' "$f")
            done
        done
        shopt -u globstar nullglob
    fi

    # NB: can't test `${#EDITION_FILES[@]}` directly under `set -u` — bash
    # (as of 5.3) treats a `declare -A` array with zero elements ever
    # assigned as unset for nounset purposes, even though the declaration
    # itself succeeded. Track the count separately instead.
    if [ "$fmt_file_count" -gt 0 ]; then
        echo "Running rustfmt check on staged files in: ${PKGS[*]}"
        fmt_failed=false
        fmt_output=""
        for ed in "${!EDITION_FILES[@]}"; do
            # shellcheck disable=SC2086 # intentional word-splitting of file list
            if ! out=$(rustfmt --check --edition "$ed" ${EDITION_FILES[$ed]} 2>&1); then
                fmt_failed=true
                fmt_output+="$out"$'\n'
            fi
        done
        if [ "$fmt_failed" = true ]; then
            echo "error: staged file(s) are not rustfmt-formatted:"
            echo "$fmt_output" | sed "s|$fmt_tmp/||g"
            exit 1
        fi
    fi

    echo "Running cargo clippy on: ${PKGS[*]}"
    cargo clippy "${PKG_ARGS[@]}" --all-targets --all-features -- -D warnings
else
    echo "No staged Rust crate files; skipping fmt/clippy."
fi

# --- Validate .calls.scm capture names (staged content only) -----------
scm_files=()
for f in "${STAGED[@]}"; do
    case "$f" in
        *.calls.scm) scm_files+=("$f") ;;
    esac
done

if [ "${#scm_files[@]}" -gt 0 ]; then
    echo "Validating .calls.scm capture names..."
    # Validate staged *content*, not the working-tree file — a file can be
    # partially staged. Materialize the staged blobs into a scratch dir
    # (preserving relative paths, so violation output matches real repo
    # paths) and delegate to validate-calls-scm.sh, the single source of
    # truth for the capture-name allowlist (see 6eedcbbb). Shares the same
    # scratch dir (and cleanup trap) as the fmt check above.
    scm_tmp="$TMP_ROOT/scm"
    for f in "${scm_files[@]}"; do
        mkdir -p "$scm_tmp/$(dirname "$f")"
        git show ":$f" > "$scm_tmp/$f"
    done
    scm_args=()
    for f in "${scm_files[@]}"; do
        scm_args+=("$scm_tmp/$f")
    done
    if ! scm_output=$(./scripts/validate-calls-scm.sh --files "${scm_args[@]}" 2>&1); then
        echo "error: invalid capture names in staged .calls.scm files:"
        echo "$scm_output" | sed "s|$scm_tmp/||g"
        exit 1
    fi
fi

# --- Run normalize checks against staged files, if the binary exists ---
if [ -x "./target/debug/normalize" ] || [ -x "./target/release/normalize" ]; then
    NORMALIZE="${NORMALIZE:-./target/debug/normalize}"
    [ -x "$NORMALIZE" ] || NORMALIZE="./target/release/normalize"

    if [ -x "$NORMALIZE" ]; then
        # All rule engines: syntax, native (broken refs, ratchet, budget, etc.), fact.
        # severity=error issues block commits; warnings are informational.
        # Scoped to staged files so unrelated uncommitted content elsewhere
        # in the workspace can't block this commit.
        echo "Running normalize rules on staged files..."
        # `--files` takes exactly one value per occurrence (clap
        # ArgAction::Append, not a multi-value list) despite the command's
        # own --help example implying space-separated values work in one
        # `--files a b` — repeat the flag once per staged file instead.
        FILE_ARGS=()
        for f in "${STAGED[@]}"; do
            FILE_ARGS+=(--files "$f")
        done
        $NORMALIZE rules run "${FILE_ARGS[@]}"
    fi
fi

echo "Pre-commit checks passed!"
