#!/usr/bin/env bash
# Pre-commit hook: format check, clippy, and normalize checks — scoped to
# what's actually staged, not the whole workspace.
#
# Auto-installed via `nix develop` shellHook. To install manually:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Why scoped: this repo runs many agents concurrently in the same working
# tree. A commit's validity must not depend on unrelated uncommitted files
# elsewhere in the workspace (a different agent's in-progress edits can
# leave other crates non-compiling). Scoping to the crates touched by the
# staged changes also cuts wall-clock from minutes (full-workspace clippy)
# to seconds for a typical single-crate commit.
#
# Guarantee traded away: this hook does NOT prove the whole workspace
# builds/lints clean, only that the touched package(s) do. It does not catch
# breakage in crates that depend on a touched crate (e.g. a signature change
# that breaks a downstream consumer). CI (.github/workflows/ci.yml) already
# runs `cargo fmt --all --check`, `cargo clippy --workspace --all-features`,
# and `cargo test --workspace` on every push/PR — that's the full-workspace
# safety net. Cargo.toml/Cargo.lock/toolchain changes fall back to a
# full-workspace check below since those affect every crate.

set -euo pipefail

# Files staged for this commit (Added/Copied/Modified/Renamed; excludes
# Deleted since there's nothing left to check).
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#STAGED[@]}" -eq 0 ]; then
    echo "No staged files; nothing to check."
    exit 0
fi

# --- Determine which cargo packages are touched -----------------------
workspace_wide=false
declare -A PKG_SET
for f in "${STAGED[@]}"; do
    case "$f" in
        Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*)
            workspace_wide=true
            ;;
        crates/*/*)
            dir="crates/$(echo "$f" | cut -d/ -f2)"
            ;;
        xtask/*)
            dir="xtask"
            ;;
        benches/*)
            dir="benches"
            ;;
        *)
            dir=""
            ;;
    esac
    if [ -n "${dir:-}" ] && [ -f "$dir/Cargo.toml" ]; then
        pkg=$(sed -n 's/^name *= *"\(.*\)"/\1/p' "$dir/Cargo.toml" | head -1)
        [ -n "$pkg" ] && PKG_SET["$pkg"]=1
    fi
    dir=""
done

PKGS=("${!PKG_SET[@]}")

if [ "$workspace_wide" = true ]; then
    echo "Workspace manifest/lockfile/toolchain staged — running full-workspace checks..."
    echo "Running cargo fmt check..."
    cargo fmt --check
    echo "Running cargo clippy (workspace)..."
    cargo clippy --all-targets --all-features -- -D warnings
elif [ "${#PKGS[@]}" -gt 0 ]; then
    PKG_ARGS=()
    for p in "${PKGS[@]}"; do
        PKG_ARGS+=(-p "$p")
    done
    echo "Running cargo fmt check on: ${PKGS[*]}"
    cargo fmt --check "${PKG_ARGS[@]}"
    echo "Running cargo clippy on: ${PKGS[*]}"
    cargo clippy "${PKG_ARGS[@]}" --all-targets --all-features -- -D warnings
else
    echo "No staged Rust crate files; skipping fmt/clippy."
fi

# --- Validate .calls.scm capture names (staged content only) -----------
scm_files=()
for f in "${STAGED[@]}"; do
    case "$f" in
        *.calls.scm) scm_files+=("$f") ;;
    esac
done

if [ "${#scm_files[@]}" -gt 0 ]; then
    echo "Validating .calls.scm capture names..."
    # Validate staged *content*, not the working-tree file — a file can be
    # partially staged. Materialize the staged blobs into a scratch dir
    # (preserving relative paths, so violation output matches real repo
    # paths) and delegate to validate-calls-scm.sh, the single source of
    # truth for the capture-name allowlist (see 6eedcbbb).
    scm_tmp="$(mktemp -d)"
    trap 'rm -rf "$scm_tmp"' EXIT
    for f in "${scm_files[@]}"; do
        mkdir -p "$scm_tmp/$(dirname "$f")"
        git show ":$f" > "$scm_tmp/$f"
    done
    scm_args=()
    for f in "${scm_files[@]}"; do
        scm_args+=("$scm_tmp/$f")
    done
    if ! scm_output=$(./scripts/validate-calls-scm.sh --files "${scm_args[@]}" 2>&1); then
        echo "error: invalid capture names in staged .calls.scm files:"
        echo "$scm_output" | sed "s|$scm_tmp/||g"
        rm -rf "$scm_tmp"
        trap - EXIT
        exit 1
    fi
    rm -rf "$scm_tmp"
    trap - EXIT
fi

# --- Run normalize checks against staged files, if the binary exists ---
if [ -x "./target/debug/normalize" ] || [ -x "./target/release/normalize" ]; then
    NORMALIZE="${NORMALIZE:-./target/debug/normalize}"
    [ -x "$NORMALIZE" ] || NORMALIZE="./target/release/normalize"

    if [ -x "$NORMALIZE" ]; then
        # All rule engines: syntax, native (broken refs, ratchet, budget, etc.), fact.
        # severity=error issues block commits; warnings are informational.
        # Scoped to staged files so unrelated uncommitted content elsewhere
        # in the workspace can't block this commit.
        echo "Running normalize rules on staged files..."
        # `--files` takes exactly one value per occurrence (clap
        # ArgAction::Append, not a multi-value list) despite the command's
        # own --help example implying space-separated values work in one
        # `--files a b` — repeat the flag once per staged file instead.
        FILE_ARGS=()
        for f in "${STAGED[@]}"; do
            FILE_ARGS+=(--files "$f")
        done
        $NORMALIZE rules run "${FILE_ARGS[@]}"
    fi
fi

echo "Pre-commit checks passed!"
